{
  "name": "gridiron-blitz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Tecmo Bowl style arcade football game built with React, TypeScript, and Pixi.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sim:kernel": "node --experimental-strip-types scripts/kernel-sweep.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.2"
  }
}
